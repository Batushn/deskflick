# deskflick device permissions.

# 1) Creating the virtual pointer clone needs /dev/uinput.
KERNEL=="uinput", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"

# 2) Reading the physical mouse. Instead of requiring `input` group membership
#    (which only takes effect after a full re-login and is broad enough to read
#    keyboards), grant an ACL to the user currently logged in at the seat, for
#    mouse devices only. Keyboards are explicitly excluded.
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_MOUSE}=="1", \
    ENV{ID_INPUT_KEYBOARD}!="1", TAG+="uaccess"
