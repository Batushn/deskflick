# deskflick device permissions.
#
# The number matters twice over: this file must sort AFTER 60-input-id.rules,
# which is what sets ID_INPUT_MOUSE, and BEFORE 73-seat-late.rules, which runs
# the `uaccess` builtin. Miss either side and the ACL is silently never
# applied.

# 1) Creating the virtual pointer clone needs /dev/uinput.
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"

# 2) Reading the physical mouse. Rather than requiring `input` group membership
#    (which needs a full re-login and also grants access to keyboards), grant an
#    ACL to the user logged in at the seat, for pointing devices.
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_MOUSE}=="1", TAG+="uaccess"
